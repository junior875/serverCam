# Copie este arquivo para .env e preencha os valores reais.

# ── Banco de dados ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://usuario:senha@localhost:5432/fluxcam

# ── HTTP API ──────────────────────────────────────────────────────────────────
PORT=8080
API_KEY=troque_por_chave_forte_aqui
SNAPSHOT_DIR=./snapshots

# ── MQTT (broker EMQX — controle e telemetria da câmera) ─────────────────────
MQTT_BROKER=seu-emqx.railway.app
MQTT_PORT=1883
MQTT_USERNAME=hivegrid
MQTT_PASSWORD=senha_forte_aqui
MQTT_CLIENT_ID=fluxcam-server

# ── TCP binário (upload de JPEG — modo 4G) ────────────────────────────────────
TCP_IMAGE_PORT=9000

# ── Thinker CLI ───────────────────────────────────────────────────────────────
# THINKER_BASE_URL=https://xxx.trycloudflare.com
